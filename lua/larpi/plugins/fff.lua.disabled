return {
    'dmtrKovalenko/fff.nvim',
    build = function()
        require('fff.download').download_or_build_binary()
    end,
    opts = {},
    keys = {
        {
            '<Leader>ff', -- try it if you didn't it is a banger keybinding for a picker
            function()
                require('fff').find_files()
            end,
            desc = '[FFF] Find Files',
        },
        {
            '<Leader>fc', -- try it if you didn't it is a banger keybinding for a picker
            function()
                require('fff').find_files({
                    cwd = vim.fn.stdpath('config'),
                })
            end,
            desc = '[FFF] Search Neovim Config',
        },
        {
            '<Leader>fw', -- try it if you didn't it is a banger keybinding for a picker
            function()
                require('fff').find_files({
                    query = vim.fn.expand('<cword>'),
                })
            end,
            desc = '[FFF] Find Word',
        },
        {
            '<Leader>fW', -- try it if you didn't it is a banger keybinding for a picker
            function()
                require('fff').find_files({
                    query = vim.fn.expand('<cWORD>'),
                })
            end,
            desc = '[FFF] Find WORD',
        },
        {
            {
                '<Leader>sg',
                function()
                    require('fff').live_grep()
                end,
                desc = '[FFF] Grep',
            },
            {
                '<Leader>sG',
                function()
                    require('fff').live_grep({
                        grep = {
                            modes = { 'fuzzy', 'plain' },
                        },
                    })
                end,
                desc = '[FFF] Fuzzy Grep',
            },
            {
                '<Leader>sc',
                function()
                    require('fff').live_grep({
                        cwd = vim.fn.stdpath('config'),
                    })
                end,
                desc = '[FFF] Search Neovim Config',
            },
            {
                '<Leader>sw',
                function()
                    require('fff').live_grep({ query = vim.fn.expand('<cword>') })
                end,
                desc = '[FFF] Search Word',
            },
            {
                '<Leader>sW',
                function()
                    require('fff').live_grep({ query = vim.fn.expand('<cWORD>') })
                end,
                desc = '[FFF] Search WORD',
            },
        },
    },
}
